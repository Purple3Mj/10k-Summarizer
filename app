    max_start = max(total - 5, 0)

    def _randomize():
        import random
        st.session_state.bench_start = random.randint(0, max_start)

    b1, b2, b3 = st.columns([2, 2, 2])
    n_rows = b1.slider("Records to evaluate", 1, 5, 2)
    start = int(b2.number_input("Start at record #", 0, max_start, 0, step=1, key="bench_start"))
    b3.write("")
    b3.button("🎲 Random records", on_click=_randomize)
    st.caption(f"Dataset size: ~{total:,} records · showing from #{start}")

    rows, live = fetch_rows(int(start), n_rows)
    if not live:
        st.warning("Could not reach the Hugging Face dataset API — showing a built-in sample instead.")

    with st.expander("Preview the records", expanded=False):
        for i, r in enumerate(rows):
            st.markdown(f"**Record {start + i}** · {len(r['input'].split()):,} words · "
                        f"sentiment label: `{r.get('llm_sentiment_class', 'n/a')}`")
            st.caption(r["input"][:600] + ("…" if len(r["input"]) > 600 else ""))

    if st.button("▶️ Run benchmark", type="primary"):
        results = []
        progress = st.progress(0.0, text="Starting…")
        for i, r in enumerate(rows):
            progress.progress(i / len(rows), text=f"Summarizing record {i + 1} of {len(rows)}…")
            try:
                res = summarize(r["input"], model_id, length, max_chunks=BENCH_MAX_CHUNKS)
            except Exception as e:
                st.error(f"Record {start + i} failed: {e}")
                continue
            pred, ref = res["executive"], r["summary"]
            results.append({
                "Record": start + i,
                "Input words": res["input_words"],
                "Summary words": res["summary_words"],
                "ROUGE-1": round(rouge_n(pred, ref, 1), 3),
                "ROUGE-2": round(rouge_n(pred, ref, 2), 3),
                "ROUGE-L": round(rouge_l(pred, ref), 3),
                "Seconds": round(res["seconds"], 1),
                "_pred": pred,
                "_ref": ref,
            })
        progress.progress(1.0, text="Done")

        if results:
            avg = lambda k: sum(x[k] for x in results) / len(results)
            a1, a2, a3, a4 = st.columns(4)
            a1.metric("Avg ROUGE-1", f"{avg('ROUGE-1'):.3f}")
            a2.metric("Avg ROUGE-2", f"{avg('ROUGE-2'):.3f}")
            a3.metric("Avg ROUGE-L", f"{avg('ROUGE-L'):.3f}")
            a4.metric("Avg time / record", f"{avg('Seconds'):.1f}s")

            st.dataframe([{k: v for k, v in x.items() if not k.startswith("_")} for x in results],
                         use_container_width=True, hide_index=True)

            for x in results:
                with st.expander(f"Record {x['Record']} — model vs. reference"):
                    l, r = st.columns(2)
                    l.markdown("**Model summary**")
                    l.write(x["_pred"])
                    r.markdown("**Reference summary**")
                    r.write(x["_ref"])
            st.caption("ROUGE ranges 0–1; for abstractive summarization of long financial text, "
                       "ROUGE-1 around 0.30–0.45 is typical. Reference summaries were written by "
                       "LLMs, so they are a useful but imperfect gold standard. Long records are summarized "
                       f"from their first {BENCH_MAX_CHUNKS} chunks only, which lowers recall.")

# ---------------------------- About ---------------------------------------------------
with about_tab:
    st.markdown(f"""
**Problem.** 10-K annual reports run hundreds of pages and assume financial background.
Investors and finance students need the key points — performance, risks, outlook —
without reading the entire filing.

**Solution.** A pre-trained abstractive summarization model condenses any pasted section
into an executive summary plus key bullet points. A benchmark mode tests the model on
real filings with reference summaries.

**How it works**
1. Text is cleaned and split into sentence-aligned chunks that fit the model's 1,024-token window.
2. Each chunk is summarized with beam search (4 beams, no repeated trigrams).
3. Chunk summaries are summarized again into one executive summary.
4. Benchmark mode computes ROUGE-1/2/L F1 against the dataset's reference summaries.

**Models:** {", ".join(f"`{m}`" for m in MODELS.values())}
**Dataset:** `{DATASET_ID}` (split `{DATASET_SPLIT}`), derived from EDGAR-CORPUS (1993–2020).

**Limitations.** Abstractive models can hallucinate or drop numbers; inputs are capped for
CPU runtime; very long sections are only partially summarized.

**Team:** {TEAM} · BAIM 660
""")
