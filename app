# --------------------------------------------------------------------------------------
# Model loading & summarization
# --------------------------------------------------------------------------------------
@st.cache_resource(max_entries=1, show_spinner="Loading summarization model (first load can take ~1 minute)…")
def load_model(model_id: str):
    tokenizer = AutoTokenizer.from_pretrained(model_id)
    model = AutoModelForSeq2SeqLM.from_pretrained(model_id)
    model.eval()
    return tokenizer, model


def clean_text(text: str) -> str:
    """Normalize whitespace and strip page artifacts common in 10-K text."""
    text = re.sub(r"\bTable of Contents\b", " ", text, flags=re.IGNORECASE)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def split_sentences(text: str) -> list[str]:
    return [s.strip() for s in re.split(r"(?<=[.!?])\s+(?=[A-Z0-9\"(])", text) if s.strip()]


def chunk_text(text: str, tokenizer, max_tokens: int) -> list[str]:
    """Pack whole sentences into chunks that fit the model's input window."""
    chunks, current, current_len = [], [], 0
    for sent in split_sentences(text):
        n = len(tokenizer.encode(sent, add_special_tokens=False))
        if n > max_tokens:  # a single huge "sentence" (e.g., a list) — hard-split it
            words = sent.split()
            step = max(50, int(max_tokens * 0.6))
            for i in range(0, len(words), step):
                piece = " ".join(words[i:i + step])
                chunks.append(piece)
            continue
        if current_len + n > max_tokens and current:
            chunks.append(" ".join(current))
            current, current_len = [], 0
        current.append(sent)
        current_len += n
    if current:
        chunks.append(" ".join(current))
    return chunks


def generate(texts: list[str], tokenizer, model, max_new: int, min_new: int, max_in: int) -> list[str]:
    outputs = []
    for t in texts:
        inputs = tokenizer(t, return_tensors="pt", truncation=True, max_length=max_in)
        with torch.no_grad():
            ids = model.generate(
                **inputs,
                max_new_tokens=max_new,
                min_new_tokens=min_new,
                num_beams=4,
                no_repeat_ngram_size=3,
                length_penalty=1.0,
                early_stopping=True,
            )
        outputs.append(tokenizer.decode(ids[0], skip_special_tokens=True).strip())
    return outputs


def summarize(text: str, model_id: str, length: str, max_chunks: int = MAX_CHUNKS) -> dict:
    tokenizer, model = load_model(model_id)
    max_in = min(getattr(tokenizer, "model_max_length", 1024) or 1024, 1024)
    lengths = {"Short": (60, 15), "Medium": (130, 40), "Detailed": (200, 70)}
    max_new, min_new = lengths[length]

    text = clean_text(text)
    truncated = len(text) > MAX_INPUT_CHARS
    text = text[:MAX_INPUT_CHARS]

    chunks = chunk_text(text, tokenizer, max_tokens=max_in - 24)
    capped = len(chunks) > max_chunks
    chunks = chunks[:max_chunks]

    start = time.time()
    # Very short input: don't force the model to write more than was given.
    in_tokens = len(tokenizer.encode(text, add_special_tokens=False))
    if in_tokens < min_new * 2:
        min_new = max(5, in_tokens // 3)
        max_new = max(min_new + 5, in_tokens)

    partials = generate(chunks, tokenizer, model, max_new, min_new, max_in)

    # Combine chunk summaries into a single executive summary when there were several chunks.
    if len(partials) > 1:
        combined = " ".join(partials)
        executive = generate([combined], tokenizer, model, max_new, min_new, max_in)[0]
    else:
        executive = partials[0] if partials else ""

    bullets = []
    for p in partials:
        bullets.extend(split_sentences(p))
    bullets = list(dict.fromkeys(b for b in bullets if len(b.split()) > 3))  # dedupe, keep order

    return {
        "executive": executive,
        "bullets": bullets,
        "chunks": len(chunks),
        "seconds": time.time() - start,
        "input_words": len(text.split()),
        "summary_words": len(executive.split()),
        "truncated": truncated,
        "capped": capped,
    }


# --------------------------------------------------------------------------------------
# Evaluation (ROUGE implemented directly so there is no extra dependency)
# --------------------------------------------------------------------------------------
def _tokens(s: str) -> list[str]:
    return re.findall(r"[a-z0-9$%.]+", s.lower())


def _f1(overlap: int, pred_n: int, ref_n: int) -> float:
    if not pred_n or not ref_n or not overlap:
        return 0.0
    p, r = overlap / pred_n, overlap / ref_n
    return 2 * p * r / (p + r)


def rouge_n(pred: str, ref: str, n: int) -> float:
    def grams(t):
        return Counter(tuple(t[i:i + n]) for i in range(len(t) - n + 1))
    pg, rg = grams(_tokens(pred)), grams(_tokens(ref))
    return _f1(sum((pg & rg).values()), sum(pg.values()), sum(rg.values()))


def rouge_l(pred: str, ref: str) -> float:
    a, b = _tokens(pred), _tokens(ref)
    if not a or not b:
        return 0.0
    prev = [0] * (len(b) + 1)
    for x in a:
        cur = [0]
        for j, y in enumerate(b):
            cur.append(prev[j] + 1 if x == y else max(prev[j + 1], cur[j]))
        prev = cur
    return _f1(prev[-1], len(a), len(b))


# --------------------------------------------------------------------------------------
# Dataset access (Hugging Face Dataset Viewer API — no full download needed)
# --------------------------------------------------------------------------------------
@st.cache_data(ttl=3600, show_spinner=False)
def dataset_size() -> int:
    try:
        r = requests.get(SIZE_API, params={"dataset": DATASET_ID}, timeout=15)
        r.raise_for_status()
        for s in r.json()["size"]["splits"]:
            if s["split"] == DATASET_SPLIT:
                return int(s["num_rows"])
    except Exception:
        pass
    return 10_000


@st.cache_data(ttl=3600, show_spinner="Fetching 10-K records from Hugging Face…")
def fetch_rows(offset: int, length: int) -> tuple[list[dict], bool]:
    try:
        r = requests.get(
            ROWS_API,
            params={"dataset": DATASET_ID, "config": DATASET_CONFIG, "split": DATASET_SPLIT,
                    "offset": offset, "length": length},
            timeout=30,
        )
        r.raise_for_status()
        rows = [item["row"] for item in r.json()["rows"]]
        rows = [x for x in rows if x.get("input") and x.get("summary")]
        if rows:
            return rows, True
    except Exception:
        pass
    return FALLBACK_ROWS, False


