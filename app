with bench_tab:
    st.subheader("Evaluate on real 10-K filings")
    st.write(
        f"Loads sample records from the public Hugging Face dataset **{DATASET_ID}** "
        "(EDGAR-CORPUS 10-K excerpts paired with reference summaries) and scores the model "
        "with ROUGE — the standard overlap metric for summarization."
    )

